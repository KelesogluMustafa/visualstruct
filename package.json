{
  "name": "visualstruct",
  "version": "0.3.2",
  "description": "Local visual compiler: small VisualSpec in, SVG/PNG/HTML and PDF/PPTX/DOCX out.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KelesogluMustafa/visualstruct.git"
  },
  "homepage": "https://github.com/KelesogluMustafa/visualstruct#readme",
  "bugs": {
    "url": "https://github.com/KelesogluMustafa/visualstruct/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "visualstruct": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"fs.cpSync('src/templates','dist/templates',{recursive:true})\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "visualstruct": "tsx src/cli.ts",
    "render": "tsx src/cli.ts render",
    "validate": "tsx src/cli.ts validate",
    "doctor": "tsx src/cli.ts doctor",
    "chatgpt:pack": "node scripts/chatgpt-plugin-pack.mjs",
    "chatgpt:test": "npm run chatgpt:pack && vitest run tests/chatgpt-plugin.test.ts",
    "desktop:runtime": "node scripts/desktop-runtime.mjs",
    "desktop:pack": "node scripts/desktop-pack.mjs",
    "test": "npm run chatgpt:pack && vitest run"
  },
  "dependencies": {
    "@lucide/icons": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "@svgdotjs/svg.js": "^3.2.8",
    "docx": "^9.9.0",
    "eta": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "svg-to-pdfkit": "^0.1.8",
    "svgdom": "^0.1.29",
    "svgo": "^4.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "ajv": "^8.20.0",
    "jszip": "^3.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
